{
  "name": "@tamer4lynx/tamer-system-ui",
  "version": "0.0.3",
  "publishConfig": { "access": "public", "tag": "prerelease" },
  "type": "module",
  "description": "Status bar and navigation bar control for Lynx.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": ["dist", "android/src", "android/build.gradle.kts", "ios", "lynx.ext.json"],
  "lynx": { "ext": "lynx.ext.json" },
  "scripts": {
    "build": "tsc"
  },
  "peerDependencies": {
    "@lynx-js/react": ">=0.100.0",
    "react": "^17.0.0"
  },
  "devDependencies": {
    "@types/react": "^17.0.0",
    "react": "^17.0.2",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": { "type": "git", "url": "https://github.com/tamer4lynx/tamer-system-ui.git" },
  "homepage": "https://github.com/tamer4lynx/tamer-system-ui#readme",
  "bugs": { "url": "https://github.com/tamer4lynx/tamer-system-ui/issues" },
